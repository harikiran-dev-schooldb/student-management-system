generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model SchoolInfo {
  id            String  @id @default(cuid())
  schoolId      String  @unique
  name          String
  address       String
  phone         String?
  email         String?
  website       String?
  logo          String?
  taxId         String?
  receiptHeader String?
  receiptFooter String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins                  Admin[]
  students                Student[]
  teachers                Teacher[]
  grades                  Grade[]
  classes                 Class[]
  subjects                Subject[]
  exams                   Exam[]
  lessons                 Lesson[]
  announcements           Announcement[]
  messages                Messages[]
  events                  Event[]
  examGradeSubjects       ExamGradeSubject[]
  results                 Result[]
  homeworks               Homework[]
  feeStructures           FeeStructure[]
  feeTransactions         FeeTransaction[]
  studentFees             StudentFees[]
  studentTotalFees        StudentTotalFees[]
  attendances             Attendance[]
  cancelledReceipts       CancelledReceipt[]
  permissionSlips         PermissionSlip[]
  feePayments             FeePayment[]
  studentEnrollments      StudentEnrollment[]
  subjectTeachers         SubjectTeacher[]
  linkedUser              LinkedUser[]
  bulkUpload              BulkUploadJob[]
  smsTemplate             SmsTemplate[]
  assignments             Assignment[]
  assignmentGradeSubjects AssignmentGradeSubject[]
  assignmentSubmissions   AssignmentSubmission[]
  academicYear            AcademicYear[]
  branches                Branch[]
  teacherClassAssignments TeacherClassAssignment[]
}

model Admin {
  id         String     @id @default(cuid())
  username   String
  password   String // Should always be hashed before storing
  name       String
  parentName String
  gender     Gender     @default(Male) // Use enum for controlled values
  email      String?
  phone      String
  address    String
  dob        DateTime?
  img        String?
  bloodType  BloodType? // Use enum for blood types
  createdAt  DateTime   @default(now())
  clerk_id   String?

  // Relations
  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?

  linkedUser   LinkedUser? @relation(fields: [linkedUserId], references: [id])
  linkedUserId String?     @unique

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@unique([clerk_id, schoolId])
  @@unique([username, schoolId])
  @@unique([email, schoolId])
  @@unique([phone, schoolId])
  @@index([username, email, phone])
  @@index([schoolId])
}

model Branch {
  id    Int        @id @default(autoincrement())
  name  String // "Kindergarten", "Primary", "Higher"
  type  BranchType
  order Int // display order

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  grades Grade[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Grade {
  id                      Int                      @id @default(autoincrement())
  level                   String
  examGradeSubjects       ExamGradeSubject[]
  feestructure            FeeStructure[]           @relation("GradeToFeesStructure")
  Homework                Homework[]
  classes                 Class[]
  subjects                Subject[]                @relation("SubjectGrades")
  assignmentGradeSubjects AssignmentGradeSubject[]
  schoolId                String
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([level, schoolId])
  @@index([level])
  @@index([schoolId])
  @@index([branchId])
}

model Class {
  id                      Int                      @id @default(autoincrement())
  name                    String?
  section                 String // e.g., "A", "B"
  gradeId                 Int
  Announcement            Announcement[]
  attendances             Attendance[]
  events                  Event[]
  homeworks               Homework[]
  lessons                 Lesson[]
  messages                Messages[]
  subjectTeachers         SubjectTeacher[]
  Grade                   Grade                    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  studentEnrollments      StudentEnrollment[]
  assignmentGradeSubjects AssignmentGradeSubject[]
  teacherClassAssignments TeacherClassAssignment[]

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([gradeId, section, schoolId], map: "Class_gradeId_section_key") // enforce uniqueness within grade
  @@index([gradeId], map: "Class_gradeId_idx")
  @@index([schoolId])
  @@map("class")
}

model Lesson {
  id        Int       @id @default(autoincrement())
  title     String // Add title here
  day       LessonDay
  startTime DateTime?
  endTime   DateTime?
  period    Period
  subjectId Int
  classId   Int
  teacherId String
  Class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  Subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([day, period])
}

model Announcement {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  classId     Int?
  Class       Class?     @relation(fields: [classId], references: [id])
  schoolId    String
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([schoolId])
}

model Messages {
  id        String      @id @default(cuid())
  message   String
  type      MessageType
  studentId String?

  date     DateTime   @default(now())
  classId  Int?
  Class    Class?     @relation(fields: [classId], references: [id])
  Student  Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  Class       Class?     @relation(fields: [classId], references: [id])
  schoolId    String
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([schoolId])
}

model Exam {
  id                Int                @id @default(autoincrement())
  title             String
  examGradeSubjects ExamGradeSubject[]
  results           Result[]
  schoolId          String
  school            SchoolInfo         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([title, schoolId])
  @@index([schoolId])
}

model ExamGradeSubject {
  id        Int        @id @default(autoincrement())
  examId    Int
  gradeId   Int
  subjectId Int
  date      DateTime
  startTime String
  maxMarks  Int
  Exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  Grade     Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  Subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolId  String
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([examId, gradeId, subjectId, schoolId])
  @@index([schoolId])
  @@index([examId])
  @@index([gradeId])
}

model Result {
  id             Int          @id @default(autoincrement())
  marks          Float
  studentId      String
  examId         Int
  subjectId      Int
  createdAt      DateTime     @default(now())
  Exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  Student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolId       String
  school         SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, examId, subjectId, academicYearId, schoolId])
  @@index([academicYearId, studentId])
  @@index([schoolId])
}

model Assignment {
  id                      Int                      @id @default(autoincrement())
  title                   String
  description             String?
  assignmentGradeSubjects AssignmentGradeSubject[]
  submissions             AssignmentSubmission[]

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([title, schoolId])
  @@index([schoolId])
}

model AssignmentGradeSubject {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  gradeId      Int
  classId      Int
  subjectId    Int
  dueDate      DateTime
  maxMarks     Int

  Assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Grade      Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  Class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  Subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, gradeId, classId, subjectId, schoolId])
  @@index([schoolId])
}

model AssignmentSubmission {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  studentId    String
  marks        Float?
  submittedAt  DateTime @default(now())
  remarks      String?

  Assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId, schoolId])
  @@index([schoolId])
}

model Homework {
  id          Int        @id @default(autoincrement())
  groupId     String? // shared group identifier
  description String
  date        DateTime   @default(now()) @db.Timestamptz(6)
  classId     Int
  gradeId     Int
  Class       Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  Grade       Grade      @relation(fields: [gradeId], references: [id])
  schoolId    String
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([gradeId])
  @@index([groupId])
  @@index([date])
  @@index([schoolId])
}

model Student {
  id String @id @default(cuid()) 
  admissionNo String?
  username      String
  name          String
  motherName    String?
  fatherName    String?
  penNo         String?
  studentAadhar String?
  fatherAadhar  String?
  motherAadhar  String?
  email         String?
  phone         String
  address       String
  img           String?
  bloodType     String?
  gender        Gender
  dob           DateTime
  createdAt     DateTime      @default(now())
  status        StudentStatus @default(ACTIVE)
  clerk_id      String?
  leftAt        DateTime?
  leftReason    String?

  attendances           Attendance[]
  feeTransactions       FeeTransaction[]
  messages              Messages[]
  studentFees           StudentFees[]
  totalFees             StudentTotalFees[]
  cancelledReceipts     CancelledReceipt[]
  permissionSlips       PermissionSlip[]
  assignmentSubmissions AssignmentSubmission[]
  payments              FeePayment[]
  enrollments           StudentEnrollment[]

  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id])

  linkedUserId String?     @unique
  linkedUser   LinkedUser? @relation(fields: [linkedUserId], references: [id])

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  results  Result[]

  @@unique([username, schoolId])
  @@unique([admissionNo, schoolId])
  @@index([schoolId])
  @@index([gender, status])
}

model Subject {
  id                      Int                      @id @default(autoincrement())
  name                    String
  createdAt               DateTime                 @default(now())
  examGradeSubjects       ExamGradeSubject[]
  lessons                 Lesson[]
  results                 Result[]
  teachers                SubjectTeacher[]
  grades                  Grade[]                  @relation("SubjectGrades")
  schoolId                String
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentGradeSubjects AssignmentGradeSubject[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Teacher {
  id String @id @default(cuid())
  username   String
  name       String
  parentName String?
  email      String?
  phone      String
  address    String
  img        String?
  bloodType  String?
  gender     Gender
  dob        DateTime?
  status     UserStatus @default(ACTIVE) // 👈 replaces deletedAt

  createdAt  DateTime  @default(now())
  leftAt     DateTime?
  leftReason String?

  // Auth / profile
  clerk_id  String?
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id])

  // Relations
  lessons  Lesson[]
  subjects SubjectTeacher[]

  // Cross-user mapping
  linkedUserId String?     @unique
  linkedUser   LinkedUser? @relation(fields: [linkedUserId], references: [id])

  teacherClassAssignments TeacherClassAssignment[]

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /**
   * ─────────────────────────────
   * INDEX STRATEGY
   * ─────────────────────────────
   */
  @@unique([username, schoolId])
  @@unique([clerk_id, schoolId])
  @@index([schoolId])
  @@index([name]) // teacher search
  @@index([phone]) // quick lookup
  @@index([clerk_id])
}

model TeacherClassAssignment {
  id             Int    @id @default(autoincrement())
  teacherId      String
  classId        Int
  academicYearId String
  schoolId       String

  role ClassTeacherRole @default(SUBJECT)

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  school       SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, academicYearId, schoolId])
  @@index([classId, academicYearId])
  @@index([schoolId])
}

model SubjectTeacher {
  subjectId Int
  teacherId String
  classId   Int
  class     Class      @relation(fields: [classId], references: [id])
  subject   Subject    @relation(fields: [subjectId], references: [id])
  teacher   Teacher    @relation(fields: [teacherId], references: [id])
  schoolId  String
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId, classId, schoolId])
  @@index([schoolId])
}

model FeeStructure {
  id             Int           @id @default(autoincrement())
  gradeId        Int
  startDate      DateTime
  dueDate        DateTime
  termFees       Int
  abacusFees     Int?
  term           Term
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  grade          Grade         @relation("GradeToFeesStructure", fields: [gradeId], references: [id])
  studentFees    StudentFees[]
  schoolId       String
  school         SchoolInfo    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([gradeId, term, academicYearId, schoolId])
  @@index([schoolId])
}

model FeeTransaction {
  id              Int          @id @default(autoincrement())
  studentId       String
  studentFeesId   Int
  term            Term
  amount          Decimal @db.Decimal(12,2)      @default(0)
  discountAmount  Decimal @db.Decimal(12,2)      @default(0)
  fineAmount      Decimal @db.Decimal(12,2)      @default(0)
  receiptDate     DateTime
  receivedDate    DateTime?    @default(now())
  receiptNo       String
  paymentMode     PaymentMode  @default(CASH)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  remarks         String?
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  transactionType String       @default("PAYMENT") // or "CANCELLED"
  updatedByName   String?
  deletedAt       DateTime?

  studentFees StudentFees @relation("FeeTransactionStudentFees", fields: [studentFeesId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId    String
  school      SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, receiptDate])
  @@index([academicYearId, receiptDate])
  @@index([studentId, academicYearId])
}

model StudentFees {
  id               Int          @id @default(autoincrement())
  studentId        String
  feeStructureId   Int
  academicYearId   String
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id])
  term             Term
  paidAmount       Int          @default(0)
  abacusPaidAmount Int?
  discountAmount   Int          @default(0)
  fineAmount       Int          @default(0)
  receiptDate      DateTime?
  receivedDate     DateTime?    @default(now())
  paymentMode      PaymentMode  @default(CASH)
  receiptNo        String?
  remarks          String?      @default("")
  updatedByName    String?

  feeTransactions FeeTransaction[] @relation("FeeTransactionStudentFees")
  feeStructure    FeeStructure     @relation(fields: [feeStructureId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId        String
  school          SchoolInfo       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, term, schoolId], name: "studentId_academicYear_term")
  @@index([schoolId])
}

model StudentTotalFees {
  id        Int    @id @default(autoincrement())
  studentId String
  schoolId  String

  totalPaidAmount     Decimal @db.Decimal(12,2) @default(0)
  totalDiscountAmount Decimal @db.Decimal(12,2) @default(0)
  totalFineAmount     Decimal @db.Decimal(12,2) @default(0)
  totalAbacusAmount   Decimal @db.Decimal(12,2) @default(0)
  totalFeeAmount      Decimal @db.Decimal(12,2) @default(0)
  dueAmount           Decimal @db.Decimal(12,2) @default(0)

  student Student    @relation(fields: [studentId], references: [id])
  school  SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId, schoolId])
  @@index([schoolId])
}

model Attendance {
  id             Int          @id @default(autoincrement())
  date           DateTime
  present        Boolean      @default(true)
  studentId      String
  classId        Int
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  Student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId       String
  school         SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, date, academicYearId, schoolId])
  @@index([classId, date])
  @@index([studentId, classId])
  @@index([schoolId])
  @@index([schoolId, date])
  @@index([academicYearId, studentId])
  @@index([schoolId, classId, date])
}

model CancelledReceipt {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  term              Term
  originalReceiptNo String
  cancelledDate     DateTime @default(now())
  cancelledBy       String? // Optional: name or user ID of admin who cancelled
  reason            String? // Optional: why it was cancelled

  cancelledAmount   Decimal @db.Decimal(12,2)    @default(0)
  cancelledDiscount Decimal @db.Decimal(12,2)    @default(0)
  cancelledFine     Decimal @db.Decimal(12,2)    @default(0)
  cancelledTotal    Decimal @db.Decimal(12,2)    @default(0) // can also be computed as sum of above
  schoolId          String
  school            SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Indexes for quick search
  @@index([studentId])
  @@index([term])
  @@index([originalReceiptNo])
  @@index([schoolId])
}

model PermissionSlip {
  id        Int     @id @default(autoincrement())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  leaveType   LeaveType
  subReason   String?
  description String?
  date        DateTime   @default(now()) // ✅ Defaults to today's date
  timeIssued  DateTime   @default(now())
  withWhom    String?
  relation    String?
  schoolId    String
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Profile {
  id       String  @id @default(cuid())
  clerk_id String? @unique
  phone    String?

  users        LinkedUser[]
  activeUserId String?      @unique
  activeUser   LinkedUser?  @relation("ActiveUser", fields: [activeUserId], references: [id])

  // Opposite sides for Admin, Student, Teacher
  admin   Admin[]
  student Student[]
  teacher Teacher[]

  @@index([clerk_id])
  @@index([phone])
}

model LinkedUser {
  id        String  @id @default(cuid())
  username  String
  role      String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  activeFor Profile? @relation("ActiveUser")

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  student Student?
  teacher Teacher?
  admin   Admin?

  @@unique([username, schoolId])
  @@index([profileId, schoolId])
}

model FeePayment {
  id Int @id @default(autoincrement())

  amount   Decimal @db.Decimal(12,2)
  currency String  @default("INR")

  paymentDate DateTime @default(now())

  status PaymentStatus @default(PENDING)

  transactionId String? @unique
  orderId       String  @unique

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // 👇 ADD THIS
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
}

model StudentEnrollment {
  id             Int              @id @default(autoincrement())
  studentId      String
  classId        Int
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  status         EnrollmentStatus @default(ACTIVE)
  promotedFromId Int?

  student  Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class    Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, schoolId])
  @@index([academicYearId, classId])
  @@index([schoolId])
}

model BulkUploadJob {
  id        String   @id @default(cuid())
  schoolId  String
  status    String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  total     Int
  processed Int      @default(0)
  created   Int      @default(0)
  updated   Int      @default(0)
  errors    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SmsTemplate {
  id      Int         @id @default(autoincrement())
  type    MessageType
  content String      @db.Text

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, schoolId])
  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String // "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  feeStructures           FeeStructure[]
  studentFees             StudentFees[]
  feeTransactions         FeeTransaction[]
  enrollments             StudentEnrollment[]
  results                 Result[]
  attendance              Attendance[]
  studentTotalFees        StudentTotalFees[]
  teacherClassAssignments TeacherClassAssignment[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

enum LessonDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Gender {
  Male
  Female
}

