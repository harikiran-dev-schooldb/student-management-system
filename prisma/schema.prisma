generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model SchoolInfo {
  id       String  @id @default(cuid())
  schoolId String  @unique
  name     String
  address  String
  phone    String?
  email    String?
  website  String?
  logo     String?
  taxId          String?
  receiptHeader  String?
  receiptFooter  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins             Admin[]
  students           Student[]
  teachers           Teacher[]
  grades             Grade[]
  classes            Class[]
  subjects           Subject[]
  exams              Exam[]
  lessons            Lesson[]
  announcements      Announcement[]
  messages           Messages[]
  events             Event[]
  examGradeSubjects  ExamGradeSubject[]
  results            Result[]
  homeworks          Homework[]
  feeStructures      FeeStructure[]
  feeTransactions    FeeTransaction[]
  studentFees        StudentFees[]
  studentTotalFees   StudentTotalFees[]
  attendances        Attendance[]
  cancelledReceipts  CancelledReceipt[]
  permissionSlips    PermissionSlip[]
  feePayments        FeePayment[]
  studentEnrollments StudentEnrollment[]
  subjectTeachers    SubjectTeacher[]
  linkedUser         LinkedUser[]
  bulkUpload         BulkUploadJob[]
}

model Admin {
  id         String     @id @default(cuid())
  username   String
  password   String // Should always be hashed before storing
  name       String
  parentName String
  gender     Gender     @default(Male) // Use enum for controlled values
  email      String?
  phone      String
  address    String
  dob        DateTime?
  img        String?
  bloodType  BloodType? // Use enum for blood types
  createdAt  DateTime   @default(now())
  clerk_id   String?

  // Relations
  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?

  linkedUser   LinkedUser? @relation(fields: [linkedUserId], references: [id])
  linkedUserId String?     @unique

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@unique([clerk_id, schoolId])
  @@unique([username, schoolId])
  @@unique([email, schoolId])
  @@unique([phone, schoolId])
  @@index([username, email, phone])
  @@index([schoolId])
}

model Grade {
  id                Int                @id @default(autoincrement())
  level             String
  examGradeSubjects ExamGradeSubject[]
  feestructure      FeeStructure[]     @relation("GradeToFeesStructure")
  Homework          Homework[]
  classes           Class[]
  subjects          Subject[]          @relation("SubjectGrades")
  schoolId          String
  school            SchoolInfo         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([level, schoolId])
  @@index([level])
  @@index([schoolId])
}

model Class {
  id                 Int                 @id @default(autoincrement())
  name               String?
  section            String // e.g., "A", "B"
  supervisorId       String?             @unique
  gradeId            Int
  Announcement       Announcement[]
  attendances        Attendance[]
  events             Event[]
  homeworks          Homework[]
  lessons            Lesson[]
  messages           Messages[]
  students           Student[]
  subjectTeachers    SubjectTeacher[]
  Grade              Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  Teacher            Teacher?            @relation("ClassToTeacher", fields: [supervisorId], references: [id])
  studentEnrollments StudentEnrollment[]

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([gradeId, section, schoolId], map: "Class_gradeId_section_key") // enforce uniqueness within grade
  @@index([gradeId], map: "Class_gradeId_idx")
  @@index([supervisorId], map: "Class_supervisorId_idx")
  @@index([schoolId])
  @@map("class")
}

model Lesson {
  id        Int       @id @default(autoincrement())
  title     String // Add title here
  day       LessonDay
  startTime DateTime?
  endTime   DateTime?
  period    Period
  subjectId Int
  classId   Int
  teacherId String
  Class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  Subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([day, period])
}

model Announcement {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  classId     Int?
  Class       Class?     @relation(fields: [classId], references: [id])
  schoolId    String
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([schoolId])
}

model Messages {
  id        String      @id @default(cuid())
  message   String
  type      MessageType
  studentId String?

  date     DateTime   @default(now())
  classId  Int?
  Class    Class?     @relation(fields: [classId], references: [id])
  Student  Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  Class       Class?     @relation(fields: [classId], references: [id])
  schoolId    String
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([schoolId])
}

model Exam {
  id                Int                @id @default(autoincrement())
  title             String
  examGradeSubjects ExamGradeSubject[]
  results           Result[]
  schoolId          String
  school            SchoolInfo         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([title, schoolId])
  @@index([schoolId])
}

model ExamGradeSubject {
  id        Int        @id @default(autoincrement())
  examId    Int
  gradeId   Int
  subjectId Int
  date      DateTime
  startTime String
  maxMarks  Int
  Exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  Grade     Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  Subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolId  String
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([examId, gradeId, subjectId, schoolId])
  @@index([schoolId])
  @@index([examId])
  @@index([gradeId])
}

model Result {
  id        Int        @id @default(autoincrement())
  marks     Float
  studentId String
  examId    Int
  subjectId Int
  createdAt DateTime   @default(now())
  Exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  Student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolId  String
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId, subjectId, schoolId])
  @@index([schoolId])
}

model Homework {
  id          Int        @id @default(autoincrement())
  groupId     String? // shared group identifier
  description String
  date        DateTime   @default(now()) @db.Timestamptz(6)
  classId     Int
  gradeId     Int
  Class       Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  Grade       Grade      @relation(fields: [gradeId], references: [id])
  schoolId    String
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([gradeId])
  @@index([groupId])
  @@index([date])
  @@index([schoolId])
}

model Student {
  id                String             @id
  username          String
  name              String
  motherName        String?
  fatherName        String?
  penNo             String?
  studentAadhar     String?
  fatherAadhar      String?
  motherAadhar      String?
  email             String?
  phone             String
  address           String
  img               String?
  bloodType         String?
  gender            Gender
  dob               DateTime
  createdAt         DateTime           @default(now())
  status            StudentStatus      @default(ACTIVE) // 👈 replaces deletedAt
  clerk_id          String? // parent’s Clerk ID (not unique now)
  academicYear      AcademicYear       @default(Y2024_2025)
  classId           Int
  attendances       Attendance[]
  feeTransactions   FeeTransaction[]
  messages          Messages[]
  results           Result[]
  Class             Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentFees       StudentFees[]
  totalFees         StudentTotalFees[]
  cancelledReceipts CancelledReceipt[]
  permissionSlips   PermissionSlip[]

  // 👇 Add these lines
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id])

  linkedUserId String?     @unique
  linkedUser   LinkedUser? @relation(fields: [linkedUserId], references: [id])

  payments FeePayment[]

  enrollments StudentEnrollment[]

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([username, schoolId])
  @@index([schoolId])
  @@index([classId, gender, status])
  @@index([academicYear, classId, gender, status])
}

model Subject {
  id                Int                @id @default(autoincrement())
  name              String
  createdAt         DateTime           @default(now())
  examGradeSubjects ExamGradeSubject[]
  lessons           Lesson[]
  results           Result[]
  teachers          SubjectTeacher[]
  grades            Grade[]            @relation("SubjectGrades")
  schoolId          String
  school            SchoolInfo         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Teacher {
  id         String     @id
  username   String
  name       String
  parentName String?
  email      String?
  phone      String
  address    String
  img        String?
  bloodType  String?
  gender     Gender
  dob        DateTime?
  status     UserStatus @default(ACTIVE) // 👈 replaces deletedAt

  supervisor Boolean @default(false)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Auth / profile
  clerk_id  String?
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id])

  // Class ownership
  classId Int?
  class   Class? @relation("ClassToTeacher")

  // Relations
  lessons  Lesson[]
  subjects SubjectTeacher[]

  // Cross-user mapping
  linkedUserId String?     @unique
  linkedUser   LinkedUser? @relation(fields: [linkedUserId], references: [id])

  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /**
   * ─────────────────────────────
   * INDEX STRATEGY
   * ─────────────────────────────
   */
  @@unique([username, schoolId])
  @@unique([clerk_id, schoolId])
  @@unique([classId, schoolId])
  @@index([schoolId])
  @@index([name]) // teacher search
  @@index([phone]) // quick lookup
  @@index([clerk_id])
}

model SubjectTeacher {
  subjectId Int
  teacherId String
  classId   Int
  class     Class      @relation(fields: [classId], references: [id])
  subject   Subject    @relation(fields: [subjectId], references: [id])
  teacher   Teacher    @relation(fields: [teacherId], references: [id])
  schoolId  String
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId, classId, schoolId])
  @@index([schoolId])
}

model FeeStructure {
  id           Int           @id @default(autoincrement())
  gradeId      Int
  startDate    DateTime
  dueDate      DateTime
  termFees     Int
  abacusFees   Int?
  term         Term
  academicYear AcademicYear  @default(Y2024_2025)
  grade        Grade         @relation("GradeToFeesStructure", fields: [gradeId], references: [id])
  studentFees  StudentFees[]
  schoolId     String
  school       SchoolInfo    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([gradeId, term, academicYear, schoolId])
  @@index([schoolId])
}

model FeeTransaction {
  id              Int          @id @default(autoincrement())
  studentId       String
  studentFeesId   Int
  term            Term
  amount          Float        @default(0)
  discountAmount  Float        @default(0)
  fineAmount      Float        @default(0)
  receiptDate     DateTime
  receivedDate    DateTime?    @default(now())
  receiptNo       String
  paymentMode     PaymentMode  @default(CASH)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  remarks         String?
  academicYear    AcademicYear @default(Y2024_2025) // 🎯 Added field
  transactionType String       @default("PAYMENT") // or "CANCELLED"
  updatedByName   String?
  deletedAt       DateTime?

  studentFees StudentFees @relation("FeeTransactionStudentFees", fields: [studentFeesId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId    String
  school      SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, receiptDate])
  @@index([academicYear, receiptDate])
  @@index([studentId, academicYear])
}

model StudentFees {
  id               Int          @id @default(autoincrement())
  studentId        String
  feeStructureId   Int
  academicYear     AcademicYear @default(Y2024_2025)
  term             Term
  paidAmount       Int          @default(0)
  abacusPaidAmount Int?
  discountAmount   Int          @default(0)
  fineAmount       Int          @default(0)
  receiptDate      DateTime?
  receivedDate     DateTime?    @default(now())
  paymentMode      PaymentMode  @default(CASH)
  receiptNo        String?
  remarks          String?      @default("")
  updatedByName    String?

  feeTransactions FeeTransaction[] @relation("FeeTransactionStudentFees")
  feeStructure    FeeStructure     @relation(fields: [feeStructureId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId        String
  school          SchoolInfo       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYear, term, schoolId], name: "studentId_academicYear_term")
  @@index([schoolId])
}

model StudentTotalFees {
  id                  Int    @id @default(autoincrement())
  studentId           String
  schoolId            String

  totalPaidAmount     Float  @default(0)
  totalDiscountAmount Float  @default(0)
  totalFineAmount     Float  @default(0)
  totalAbacusAmount   Float  @default(0)
  totalFeeAmount      Float  @default(0)
  dueAmount           Float  @default(0)
  status              String @default("Not Paid")

  student Student @relation(fields: [studentId], references: [id])
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolId])   // ✅ Composite unique
  @@index([schoolId])
}

model Attendance {
  id        Int        @id @default(autoincrement())
  date      DateTime
  present   Boolean    @default(true)
  studentId String
  classId   Int
  class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  Student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId  String
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, schoolId])
  @@index([classId, date])
  @@index([studentId, classId])
  @@index([schoolId])
  @@index([schoolId, date])
}

model CancelledReceipt {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  term              Term
  originalReceiptNo String
  cancelledDate     DateTime @default(now())
  cancelledBy       String? // Optional: name or user ID of admin who cancelled
  reason            String? // Optional: why it was cancelled

  cancelledAmount   Decimal    @default(0)
  cancelledDiscount Decimal    @default(0)
  cancelledFine     Decimal    @default(0)
  cancelledTotal    Decimal    @default(0) // can also be computed as sum of above
  schoolId          String
  school            SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Indexes for quick search
  @@index([studentId])
  @@index([term])
  @@index([originalReceiptNo])
  @@index([schoolId])
}

model PermissionSlip {
  id        Int     @id @default(autoincrement())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  leaveType   LeaveType
  subReason   String?
  description String?
  date        DateTime   @default(now()) // ✅ Defaults to today's date
  timeIssued  DateTime   @default(now())
  withWhom    String?
  relation    String?
  schoolId    String
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Profile {
  id       String  @id @default(cuid())
  clerk_id String? @unique
  phone    String?

  users        LinkedUser[]
  activeUserId String?      @unique
  activeUser   LinkedUser?  @relation("ActiveUser", fields: [activeUserId], references: [id])

  // Opposite sides for Admin, Student, Teacher
  admin   Admin[]
  student Student[]
  teacher Teacher[]

  @@index([clerk_id])
  @@index([phone])
}

model LinkedUser {
  id        String  @id @default(cuid())
  username  String
  role      String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  activeFor Profile? @relation("ActiveUser")

  schoolId  String
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  student Student?
  teacher Teacher?
  admin   Admin?

  @@unique([username, schoolId])
  @@index([profileId, schoolId])
}

model FeePayment {
  id            Int      @id @default(autoincrement())

  amount        Float
  currency      String   @default("INR")

  paymentDate   DateTime @default(now())

  status        PaymentStatus @default(PENDING)

  transactionId String?  @unique  // Razorpay Payment ID
  orderId       String   @unique  // Razorpay Order ID (must be unique)

  studentId     String
  student       Student    @relation(fields: [studentId], references: [id])

  schoolId      String
  school        SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
}

model StudentEnrollment {
  id             Int              @id @default(autoincrement())
  studentId      String
  classId        Int
  academicYear   AcademicYear
  status         EnrollmentStatus @default(ACTIVE)
  promotedFromId Int?

  student  Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class    Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYear, schoolId])
  @@index([academicYear, classId])
  @@index([schoolId])
}

model BulkUploadJob {
  id         String   @id @default(cuid())
  schoolId   String
  status     String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  total      Int
  processed  Int      @default(0)
  created    Int      @default(0)
  updated    Int      @default(0)
  errors     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school     SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

enum LessonDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Gender {
  Male
  Female
}

enum Term {
  TERM_1
  TERM_2
  TERM_3
  TERM_4
}

enum PaymentMode {
  CASH
  ONLINE
  UPI
  BANK_TRANSFER
}

enum AcademicYear {
  Y2024_2025
  Y2025_2026
}

enum MessageType {
  ABSENT
  FEE_RELATED
  ANNOUNCEMENT
  GENERAL
  FEE_COLLECTION
  HOMEWORK
  EXAM_RESULT
  EVENT
}

enum LeaveType {
  SICK
  PERSONAL
  HALFDAY
  DAILY_PERMISSION
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  SUSPENDED
}

enum Period {
  PERIOD1
  PERIOD2
  PERIOD3
  PERIOD4
  PERIOD5
  PERIOD6
  PERIOD7
  PERIOD8
  BREAK1
  BREAK2
  LUNCH
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  TRANSFERRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
