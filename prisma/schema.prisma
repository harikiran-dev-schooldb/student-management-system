generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model SchoolInfo {
  id                      String                   @id @default(cuid())
  schoolId                String                   @unique
  name                    String
  address                 String
  phone                   String?
  email                   String?
  website                 String?
  logo                    String?
  taxId                   String?
  receiptHeader           String?
  receiptFooter           String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  academicYear            AcademicYear[]
  admins                  Admin[]
  announcements           Announcement[]
  assignments             Assignment[]
  assignmentGradeSubjects AssignmentGradeSubject[]
  assignmentSubmissions   AssignmentSubmission[]
  attendances             Attendance[]
  staffAttendances        StaffAttendance[]
  branches                Branch[]
  cancelledReceipts       CancelledReceipt[]
  events                  Event[]
  exams                   Exam[]
  examGradeSubjects       ExamGradeSubject[]
  feePayments             FeePayment[]
  feeStructures           FeeStructure[]
  feeTransactions         FeeTransaction[]
  grades                  Grade[]
  homeworks               Homework[]
  lessons                 Lesson[]
  linkedUser              LinkedUser[]
  messages                Messages[]
  permissionSlips         PermissionSlip[]
  reciepts                ReceiptSequence[]
  results                 Result[]
  smsTemplate             SmsTemplate[]
  students                Student[]
  studentEnrollments      StudentEnrollment[]
  studentFees             StudentFees[]
  studentTotalFees        StudentTotalFees[]
  subjects                Subject[]
  subjectTeachers         SubjectTeacher[]
  teachers                Teacher[]
  teacherClassAssignments TeacherClassAssignment[]
  classes                 Class[]
  auditlog                AuditLog[]
  paymentaccount          PaymentAccount[]
  feeCycles               FeeCycle[]
}

model Admin {
  id           String      @id @default(cuid())
  username     String
  name         String
  parentName   String
  gender       Gender      @default(Male)
  email        String?
  phone        String
  address      String
  dob          DateTime?
  img          String?
  bloodType    BloodType?
  createdAt    DateTime    @default(now())
  clerk_id     String?
  profileId    String?
  linkedUserId String?     @unique
  schoolId     String
  linkedUser   LinkedUser? @relation(fields: [linkedUserId], references: [id])
  profile      Profile?    @relation(fields: [profileId], references: [id])
  school       SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@unique([clerk_id, schoolId])
  @@unique([username, schoolId])
  @@unique([email, schoolId])
  @@unique([phone, schoolId])
  @@index([username, email, phone])
  @@index([schoolId])
}

model Branch {
  id       Int        @id @default(autoincrement())
  name     String
  type     BranchType
  order    Int
  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grades   Grade[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Grade {
  id                      Int                      @id @default(autoincrement())
  level                   String
  schoolId                String
  branchId                Int
  assignmentGradeSubjects AssignmentGradeSubject[]
  examGradeSubjects       ExamGradeSubject[]
  feestructure            FeeStructure[]           @relation("GradeToFeesStructure")
  branch                  Branch                   @relation(fields: [branchId], references: [id])
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Homework                Homework[]
  classes                 Class[]
  subjects                Subject[]                @relation("SubjectGrades")

  @@unique([level, schoolId])
  @@index([level])
  @@index([schoolId])
  @@index([branchId])
}

model Class {
  id                      Int                      @id @default(autoincrement())
  name                    String?
  section                 String
  gradeId                 Int
  schoolId                String
  Announcement            Announcement[]
  assignmentGradeSubjects AssignmentGradeSubject[]
  attendances             Attendance[]
  events                  Event[]
  homeworks               Homework[]
  lessons                 Lesson[]
  messages                Messages[]
  studentEnrollments      StudentEnrollment[]
  subjectTeachers         SubjectTeacher[]
  teacherClassAssignments TeacherClassAssignment[]
  Grade                   Grade                    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([gradeId, section, schoolId], map: "Class_gradeId_section_key")
  @@index([gradeId], map: "Class_gradeId_idx")
  @@index([schoolId])
  @@index([schoolId, gradeId])
  @@map("class")
}

model Lesson {
  id        Int        @id @default(autoincrement())
  title     String
  day       LessonDay
  startTime DateTime?
  endTime   DateTime?
  period    Period
  subjectId Int
  classId   Int
  teacherId String
  schoolId  String
  Class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Teacher   Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([day, period])
}

model Announcement {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  branchId    Int?
  gradeId     Int?
  classId     Int?
  schoolId    String
  Class       Class?     @relation(fields: [classId], references: [id])
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([schoolId])
}

model Messages {
  id        String      @id @default(cuid())
  message   String
  type      MessageType
  studentId String?
  date      DateTime    @default(now())
  classId   Int?
  schoolId  String
  branchId  Int?
  gradeId   Int?
  Class     Class?      @relation(fields: [classId], references: [id])
  school    SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Student   Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  branchId    Int?
  gradeId     Int?
  classId     Int?
  schoolId    String
  Class       Class?     @relation(fields: [classId], references: [id])
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([schoolId])
}

model Exam {
  id                Int                @id @default(autoincrement())
  title             String
  schoolId          String
  academicYearId    Int
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  school            SchoolInfo         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examGradeSubjects ExamGradeSubject[]
  results           Result[]

  @@unique([title, academicYearId, schoolId])
  @@index([schoolId])
  @@index([academicYearId])
}

model ExamGradeSubject {
  id             Int          @id @default(autoincrement())
  examId         Int
  gradeId        Int
  subjectId      Int
  date           DateTime
  startTime      String
  maxMarks       Int
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  grade          Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  school         SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, gradeId, subjectId, academicYearId, schoolId])
  @@index([schoolId])
  @@index([examId])
  @@index([gradeId])
  @@index([subjectId])
}

model Result {
  id             Int          @id @default(autoincrement())
  marks          Float
  studentId      String
  examId         Int
  subjectId      Int
  createdAt      DateTime     @default(now())
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  school         SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId, subjectId, academicYearId, schoolId])
  @@index([examId, schoolId, studentId])
  @@index([academicYearId])
}

model Assignment {
  id                      Int                      @id @default(autoincrement())
  title                   String
  description             String?
  schoolId                String
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentGradeSubjects AssignmentGradeSubject[]
  submissions             AssignmentSubmission[]

  @@unique([title, schoolId])
  @@index([schoolId])
}

model AssignmentGradeSubject {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  gradeId      Int
  classId      Int
  subjectId    Int
  dueDate      DateTime
  maxMarks     Int
  schoolId     String
  Assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  Grade        Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  school       SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, gradeId, classId, subjectId, schoolId])
  @@index([schoolId])
}

model AssignmentSubmission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  studentId    String
  marks        Float?
  submittedAt  DateTime   @default(now())
  remarks      String?
  schoolId     String
  Assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  school       SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId, schoolId])
  @@index([schoolId])
}

model Homework {
  id          Int        @id @default(autoincrement())
  groupId     String?
  description String
  date        DateTime   @default(now()) @db.Timestamptz(6)
  branchId    Int
  gradeId     Int
  classId     Int
  schoolId    String
  Class       Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  Grade       Grade      @relation(fields: [gradeId], references: [id])
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([gradeId])
  @@index([groupId])
  @@index([date])
  @@index([schoolId])
}

model Student {
  id       String @id @default(cuid())
  username String
  name     String

  // Parent Details
  motherName          String?
  fatherName          String?
  fatherQualification String?
  fatherProfession    String?
  motherQualification String?
  motherProfession    String?

  // Government & Identity
  penNo         String?
  studentAadhar String?
  fatherAadhar  String?
  motherAadhar  String?

  // Contact Details
  email   String?
  phone   String
  address String

  // Personal Details
  img          String?
  bloodType    String?
  gender       Gender
  dob          DateTime
  joinedDate   DateTime?
  nationality  String?
  motherTongue String?
  religion     Religion?
  category     Category?

  // System Fields
  createdAt         DateTime      @default(now())
  status            StudentStatus @default(ACTIVE)
  clerk_id          String?
  profileId         String?
  linkedUserId      String?       @unique
  schoolId          String
  leftAt            DateTime?
  leftReason        String?
  admissionNo       String?
  transportRequired Boolean       @default(false)
  hostelRequired    Boolean       @default(false)

  // Relations
  assignmentSubmissions AssignmentSubmission[]
  attendances           Attendance[]
  cancelledReceipts     CancelledReceipt[]
  payments              FeePayment[]
  feeTransactions       FeeTransaction[]
  messages              Messages[]
  permissionSlips       PermissionSlip[]
  results               Result[]

  linkedUser LinkedUser? @relation(fields: [linkedUserId], references: [id])
  profile    Profile?    @relation(fields: [profileId], references: [id])
  school     SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]
  studentFees StudentFees[]
  totalFees   StudentTotalFees[]

  @@unique([username, schoolId])
  @@unique([admissionNo, schoolId])
  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([gender, status])
}

model Subject {
  id                      Int                      @id @default(autoincrement())
  name                    String
  createdAt               DateTime                 @default(now())
  schoolId                String
  assignmentGradeSubjects AssignmentGradeSubject[]
  examGradeSubjects       ExamGradeSubject[]
  lessons                 Lesson[]
  results                 Result[]
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers                SubjectTeacher[]
  grades                  Grade[]                  @relation("SubjectGrades")

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Teacher {
  id                      String                   @id @default(cuid())
  username                String
  name                    String
  parentName              String?
  email                   String?
  phone                   String
  address                 String
  img                     String?
  bloodType               String?
  gender                  Gender
  dob                     DateTime?
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  clerk_id                String?
  profileId               String?
  linkedUserId            String?                  @unique
  schoolId                String
  leftAt                  DateTime?
  leftReason              String?
  lessons                 Lesson[]
  subjects                SubjectTeacher[]
  staffAttendances        StaffAttendance[]
  linkedUser              LinkedUser?              @relation(fields: [linkedUserId], references: [id])
  profile                 Profile?                 @relation(fields: [profileId], references: [id])
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherClassAssignments TeacherClassAssignment[]

  @@unique([username, schoolId])
  @@unique([clerk_id, schoolId])
  @@index([schoolId])
  @@index([name])
  @@index([phone])
  @@index([clerk_id])
}

model TeacherClassAssignment {
  id             Int              @id @default(autoincrement())
  teacherId      String
  classId        Int
  schoolId       String
  role           ClassTeacherRole @default(SUBJECT)
  academicYearId Int
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         SchoolInfo       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, academicYearId, schoolId])
  @@index([classId, academicYearId])
  @@index([schoolId, classId])
  @@index([schoolId])
}

model SubjectTeacher {
  subjectId Int
  teacherId String
  classId   Int
  schoolId  String
  class     Class      @relation(fields: [classId], references: [id])
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id])
  teacher   Teacher    @relation(fields: [teacherId], references: [id])

  @@id([subjectId, teacherId, classId, schoolId])
  @@index([schoolId])
  @@index([teacherId, schoolId])
  @@index([classId, schoolId])
  @@index([subjectId, schoolId])
}

model FeeCycle {
  id        Int      @id @default(autoincrement())
  name      String
  order     Int
  startDate DateTime
  dueDate   DateTime
  type      String

  schoolId       String
  academicYearId Int

  school       SchoolInfo   @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  feeStructures FeeStructure[]

  studentFees StudentFees[]

  feeTransactions   FeeTransaction[]
  cancelledReceipts CancelledReceipt[]

  @@unique([name, schoolId, academicYearId])
  @@index([schoolId])
}

model FeeStructure {
  id         Int     @id @default(autoincrement())
  gradeId    Int
  feeCycleId Int?
  amount     Int?
  feeType    String?

  schoolId       String
  academicYearId Int

  feeCycle     FeeCycle?     @relation(fields: [feeCycleId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  grade        Grade         @relation("GradeToFeesStructure", fields: [gradeId], references: [id])
  school       SchoolInfo    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFees  StudentFees[]

  @@unique([gradeId, feeCycleId, feeType, academicYearId, schoolId])
  @@index([schoolId])
}

model FeeTransaction {
  id            Int     @id @default(autoincrement())
  studentId     String
  studentFeesId Int
  feeCycleId    Int?
  admissionNo   String?

  amount         Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  fineAmount     Decimal @default(0) @db.Decimal(12, 2)

  receiptDate  DateTime
  receivedDate DateTime?   @default(now())
  receiptNo    String
  paymentMode  PaymentMode @default(CASH)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  remarks         String?
  transactionType String    @default("PAYMENT")
  updatedByName   String?
  deletedAt       DateTime?

  schoolId       String
  academicYearId Int

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  school       SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFees  StudentFees  @relation("FeeTransactionStudentFees", fields: [studentFeesId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeCycle     FeeCycle?    @relation(fields: [feeCycleId], references: [id])

  @@unique([receiptNo, schoolId])
  @@index([schoolId])
  @@index([studentFeesId])
  @@index([feeCycleId])
}

model StudentFees {
  id             Int     @id @default(autoincrement())
  studentId      String
  feeStructureId Int
  feeCycleId     Int?
  feeType        String?

  paidAmount     Int  @default(0)
  dueAmount      Int?
  discountAmount Int  @default(0)
  fineAmount     Int  @default(0)

  receiptDate   DateTime?
  receivedDate  DateTime?   @default(now())
  paymentMode   PaymentMode @default(CASH)
  receiptNo     String?
  remarks       String?     @default("")
  updatedByName String?

  schoolId       String
  academicYearId Int

  feeTransactions FeeTransaction[] @relation("FeeTransactionStudentFees")
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  feeStructure    FeeStructure     @relation(fields: [feeStructureId], references: [id])
  feeCycle        FeeCycle?        @relation(fields: [feeCycleId], references: [id])
  school          SchoolInfo       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeCycleId, feeType, academicYearId, schoolId])
  @@index([schoolId])
}

model StudentTotalFees {
  id                  Int          @id @default(autoincrement())
  studentId           String
  schoolId            String
  totalPaidAmount     Decimal      @default(0) @db.Decimal(12, 2)
  totalDiscountAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalFineAmount     Decimal      @default(0) @db.Decimal(12, 2)
  totalAbacusAmount   Decimal      @default(0) @db.Decimal(12, 2)
  totalFeeAmount      Decimal      @default(0) @db.Decimal(12, 2)
  dueAmount           Decimal      @default(0) @db.Decimal(12, 2)
  academicYearId      Int
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id])
  school              SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student             Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicYearId, schoolId])
  @@index([schoolId])
}

model Attendance {
  id             Int          @id @default(autoincrement())
  date           DateTime
  present        Boolean      @default(true)
  studentId      String
  classId        Int
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, academicYearId, schoolId])
  @@index([classId, date])
  @@index([studentId, classId])
  @@index([schoolId])
  @@index([schoolId, date])
  @@index([academicYearId, studentId])
  @@index([schoolId, classId, date])
  @@index([schoolId, classId, present])
}

model StaffAttendance {
  id             Int                   @id @default(autoincrement())
  date           DateTime
  status         StaffAttendanceStatus @default(PRESENT)
  checkIn        DateTime?
  checkOut       DateTime?
  remarks        String?
  teacherId      String
  schoolId       String
  academicYearId Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  academicYear   AcademicYear          @relation(fields: [academicYearId], references: [id])
  school         SchoolInfo            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher        Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date, academicYearId, schoolId])
  @@index([schoolId])
  @@index([schoolId, date])
  @@index([teacherId, date])
  @@index([academicYearId, teacherId])
  @@index([schoolId, status])
}

model CancelledReceipt {
  id                String   @id @default(cuid())
  studentId         String
  feeCycleId        Int?
  academicYearId    Int
  originalReceiptNo String?
  cancelledDate     DateTime @default(now())
  cancelledBy       String?
  reason            String?
  cancelledAmount   Decimal  @default(0) @db.Decimal(12, 2)
  cancelledDiscount Decimal  @default(0) @db.Decimal(12, 2)
  cancelledFine     Decimal  @default(0) @db.Decimal(12, 2)
  cancelledTotal    Decimal  @default(0) @db.Decimal(12, 2)
  schoolId          String

  school       SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id])
  feeCycle     FeeCycle?    @relation(fields: [feeCycleId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([studentId])
  @@index([feeCycleId])
  @@index([academicYearId])
  @@index([schoolId])
}

model PermissionSlip {
  id          Int        @id @default(autoincrement())
  studentId   String
  leaveType   LeaveType
  subReason   String?
  description String?
  date        DateTime   @default(now())
  timeIssued  DateTime   @default(now())
  withWhom    String?
  relation    String?
  schoolId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id])

  @@index([schoolId])
}

model Profile {
  id           String       @id @default(cuid())
  clerk_id     String?      @unique
  phone        String       @unique
  activeUserId String?
  admin        Admin[]
  users        LinkedUser[] @relation("ProfileUsers")
  activeUser   LinkedUser?  @relation("ActiveUser", fields: [activeUserId], references: [id])
  student      Student[]
  teacher      Teacher[]

  @@index([clerk_id])
}

model LinkedUser {
  id        String     @id @default(cuid())
  username  String
  role      String
  profileId String
  schoolId  String
  admin     Admin?
  profile   Profile    @relation("ProfileUsers", fields: [profileId], references: [id])
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activeFor Profile[]  @relation("ActiveUser")
  student   Student?
  teacher   Teacher?

  @@unique([username, schoolId])
  @@index([profileId, schoolId])
}

model FeePayment {
  id            Int           @id @default(autoincrement())
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  paymentDate   DateTime      @default(now())
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  orderId       String        @unique
  studentId     String
  schoolId      String
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  school        SchoolInfo    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
}

model PaymentAccount {
  id        String @id @default(cuid())
  schoolId  String
  branchId  Int // ✅ make required
  gradeId   Int // ✅ make required
  accountId String

  school SchoolInfo @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, branchId, gradeId]) // 🔥 FIX
}

model AuditLog {
  id        String     @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  schoolId  String
  school    SchoolInfo @relation(fields: [schoolId], references: [id])
  createdAt DateTime   @default(now())
}

model StudentEnrollment {
  id             Int              @id @default(autoincrement())
  studentId      String
  classId        Int
  status         EnrollmentStatus @default(ACTIVE)
  promotedFromId Int?
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         SchoolInfo       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, schoolId])
  @@index([academicYearId, classId])
  @@index([schoolId])
}

model ReceiptSequence {
  id             Int          @id @default(autoincrement())
  schoolId       String
  currentNo      Int          @default(0)
  updatedAt      DateTime     @updatedAt
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  school         SchoolInfo   @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, academicYearId])
}

model IdentityJob {
  id String @id @default(uuid())

  username String
  phone    String
  name     String
  role     String
  schoolId String

  status   String  @default("pending") // pending | processing | done | failed
  attempts Int     @default(0)
  error    String?

  nextRunAt DateTime? // for retry backoff
  lockedAt  DateTime? // detect stuck jobs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([username, schoolId]) // 🔥 CRITICAL
  @@index([status, nextRunAt])
}

model UploadSession {
  id       String @id @default(uuid())
  schoolId String

  total     Int
  processed Int @default(0)
  created   Int @default(0)
  updated   Int @default(0)
  failed    Int @default(0)

  status String @default("processing") // processing | done | failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdentityBackfillJob {
  id        String   @id @default(uuid())
  schoolId  String
  status    String   @default("pending")
  total     Int      @default(0)
  processed Int      @default(0)
  success   Int      @default(0)
  failed    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
}

model SmsTemplate {
  id        Int         @id @default(autoincrement())
  type      MessageType
  content   String
  schoolId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  school    SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([type, schoolId])
  @@index([schoolId])
}

model AcademicYear {
  name                    String
  startDate               DateTime
  endDate                 DateTime
  isActive                Boolean                  @default(false)
  schoolId                String
  id                      Int                      @id @default(autoincrement())
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendance              Attendance[]
  staffAttendances        StaffAttendance[]
  exams                   Exam[]
  examGradeSubject        ExamGradeSubject[]
  feeStructures           FeeStructure[]
  feeTransactions         FeeTransaction[]
  reciepts                ReceiptSequence[]
  results                 Result[]
  enrollments             StudentEnrollment[]
  studentFees             StudentFees[]
  studentTotalFees        StudentTotalFees[]
  teacherClassAssignments TeacherClassAssignment[]
  feeCycles               FeeCycle[]
  cancelledReceipts       CancelledReceipt[]

  @@unique([name, schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId])
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  schoolId  String?
  createdAt DateTime @default(now())
}

model Bus {
  id          String @id @default(cuid())
  number      String
  driverName  String
  driverPhone String
  schoolId    String

  routeId String?
  route   Route?  @relation(fields: [routeId], references: [id])

  createdAt DateTime @default(now())
}

model Route {
  id       String @id @default(cuid())
  name     String
  schoolId String

  stops Stop[]
  buses Bus[]
}

model Stop {
  id        String @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  order     Int
  routeId   String

  route Route @relation(fields: [routeId], references: [id])
}

model StudentTransport {
  id        String @id @default(cuid())
  studentId String
  busId     String
  stopId    String

  assignedAt DateTime @default(now())
}

