generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model SchoolInfo {
  id                      String                   @id @default(cuid())
  schoolId                String                   @unique
  name                    String
  address                 String
  phone                   String?
  email                   String?
  website                 String?
  logo                    String?
  taxId                   String?
  receiptHeader           String?
  receiptFooter           String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  academicYear            AcademicYear[]
  admins                  Admin[]
  announcements           Announcement[]
  assignments             Assignment[]
  assignmentGradeSubjects AssignmentGradeSubject[]
  assignmentSubmissions   AssignmentSubmission[]
  attendances             Attendance[]
  branches                Branch[]
  cancelledReceipts       CancelledReceipt[]
  events                  Event[]
  exams                   Exam[]
  examGradeSubjects       ExamGradeSubject[]
  feePayments             FeePayment[]
  feeStructures           FeeStructure[]
  feeTransactions         FeeTransaction[]
  grades                  Grade[]
  homeworks               Homework[]
  lessons                 Lesson[]
  linkedUser              LinkedUser[]
  messages                Messages[]
  permissionSlips         PermissionSlip[]
  reciepts                ReceiptSequence[]
  results                 Result[]
  smsTemplate             SmsTemplate[]
  students                Student[]
  studentEnrollments      StudentEnrollment[]
  studentFees             StudentFees[]
  studentTotalFees        StudentTotalFees[]
  subjects                Subject[]
  subjectTeachers         SubjectTeacher[]
  teachers                Teacher[]
  teacherClassAssignments TeacherClassAssignment[]
  classes                 Class[]
}

model Admin {
  id           String      @id @default(cuid())
  username     String
  password     String
  name         String
  parentName   String
  gender       Gender      @default(Male)
  email        String?
  phone        String
  address      String
  dob          DateTime?
  img          String?
  bloodType    BloodType?
  createdAt    DateTime    @default(now())
  clerk_id     String?
  profileId    String?
  linkedUserId String?     @unique
  schoolId     String
  linkedUser   LinkedUser? @relation(fields: [linkedUserId], references: [id])
  profile      Profile?    @relation(fields: [profileId], references: [id])
  school       SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([id, schoolId])
  @@unique([clerk_id, schoolId])
  @@unique([username, schoolId])
  @@unique([email, schoolId])
  @@unique([phone, schoolId])
  @@index([username, email, phone])
  @@index([schoolId])
}

model Branch {
  id       Int        @id @default(autoincrement())
  name     String
  type     BranchType
  order    Int
  schoolId String
  school   SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grades   Grade[]

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Grade {
  id                      Int                      @id @default(autoincrement())
  level                   String
  schoolId                String
  branchId                Int
  assignmentGradeSubjects AssignmentGradeSubject[]
  examGradeSubjects       ExamGradeSubject[]
  feestructure            FeeStructure[]           @relation("GradeToFeesStructure")
  branch                  Branch                   @relation(fields: [branchId], references: [id])
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Homework                Homework[]
  classes                 Class[]
  subjects                Subject[]                @relation("SubjectGrades")

  @@unique([level, schoolId])
  @@index([level])
  @@index([schoolId])
  @@index([branchId])
}

model Class {
  id                      Int                      @id @default(autoincrement())
  name                    String?
  section                 String
  gradeId                 Int
  schoolId                String
  Announcement            Announcement[]
  assignmentGradeSubjects AssignmentGradeSubject[]
  attendances             Attendance[]
  events                  Event[]
  homeworks               Homework[]
  lessons                 Lesson[]
  messages                Messages[]
  studentEnrollments      StudentEnrollment[]
  subjectTeachers         SubjectTeacher[]
  teacherClassAssignments TeacherClassAssignment[]
  Grade                   Grade                    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([gradeId, section, schoolId], map: "Class_gradeId_section_key")
  @@index([gradeId], map: "Class_gradeId_idx")
  @@index([schoolId])
  @@index([schoolId, gradeId])
  @@map("class")
}

model Lesson {
  id        Int        @id @default(autoincrement())
  title     String
  day       LessonDay
  startTime DateTime?
  endTime   DateTime?
  period    Period
  subjectId Int
  classId   Int
  teacherId String
  schoolId  String
  Class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Teacher   Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([day, period])
}

model Announcement {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  classId     Int?
  schoolId    String
  Class       Class?     @relation(fields: [classId], references: [id])
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([schoolId])
}

model Messages {
  id        String      @id @default(cuid())
  message   String
  type      MessageType
  studentId String?
  date      DateTime    @default(now())
  classId   Int?
  schoolId  String
  Class     Class?      @relation(fields: [classId], references: [id])
  school    SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Student   Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  schoolId    String
  Class       Class?     @relation(fields: [classId], references: [id])
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([schoolId])
}

model Exam {
  id                Int                @id @default(autoincrement())
  title             String
  schoolId          String
  academicYearId    Int
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  school            SchoolInfo         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examGradeSubjects ExamGradeSubject[]
  results           Result[]

  @@unique([title, academicYearId, schoolId])
  @@index([schoolId])
  @@index([academicYearId])
}

model ExamGradeSubject {
  id             Int          @id @default(autoincrement())
  examId         Int
  gradeId        Int
  subjectId      Int
  date           DateTime
  startTime      String
  maxMarks       Int
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  grade          Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  school         SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, gradeId, subjectId, academicYearId, schoolId])
  @@index([schoolId])
  @@index([examId])
  @@index([gradeId])
  @@index([subjectId])
}

model Result {
  id             Int          @id @default(autoincrement())
  marks          Float
  studentId      String
  examId         Int
  subjectId      Int
  createdAt      DateTime     @default(now())
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  school         SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId, subjectId, academicYearId, schoolId])
  @@index([examId, schoolId, studentId])
  @@index([academicYearId])
}

model Assignment {
  id                      Int                      @id @default(autoincrement())
  title                   String
  description             String?
  schoolId                String
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignmentGradeSubjects AssignmentGradeSubject[]
  submissions             AssignmentSubmission[]

  @@unique([title, schoolId])
  @@index([schoolId])
}

model AssignmentGradeSubject {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  gradeId      Int
  classId      Int
  subjectId    Int
  dueDate      DateTime
  maxMarks     Int
  schoolId     String
  Assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  Grade        Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  school       SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, gradeId, classId, subjectId, schoolId])
  @@index([schoolId])
}

model AssignmentSubmission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  studentId    String
  marks        Float?
  submittedAt  DateTime   @default(now())
  remarks      String?
  schoolId     String
  Assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  school       SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId, schoolId])
  @@index([schoolId])
}

model Homework {
  id          Int        @id @default(autoincrement())
  groupId     String?
  description String
  date        DateTime   @default(now()) @db.Timestamptz(6)
  classId     Int
  gradeId     Int
  schoolId    String
  Class       Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  Grade       Grade      @relation(fields: [gradeId], references: [id])
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([gradeId])
  @@index([groupId])
  @@index([date])
  @@index([schoolId])
}

model Student {
  id                    String                 @id @default(cuid())
  username              String
  name                  String
  motherName            String?
  fatherName            String?
  penNo                 String?
  studentAadhar         String?
  fatherAadhar          String?
  motherAadhar          String?
  email                 String?
  phone                 String
  address               String
  img                   String?
  bloodType             String?
  gender                Gender
  dob                   DateTime
  createdAt             DateTime               @default(now())
  status                StudentStatus          @default(ACTIVE)
  clerk_id              String?
  profileId             String?
  linkedUserId          String?                @unique
  schoolId              String
  leftAt                DateTime?
  leftReason            String?
  admissionNo           String?
  assignmentSubmissions AssignmentSubmission[]
  attendances           Attendance[]
  cancelledReceipts     CancelledReceipt[]
  payments              FeePayment[]
  feeTransactions       FeeTransaction[]
  messages              Messages[]
  permissionSlips       PermissionSlip[]
  results               Result[]
  linkedUser            LinkedUser?            @relation(fields: [linkedUserId], references: [id])
  profile               Profile?               @relation(fields: [profileId], references: [id])
  school                SchoolInfo             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments           StudentEnrollment[]
  studentFees           StudentFees[]
  totalFees             StudentTotalFees[]

  @@unique([username, schoolId])
  @@unique([admissionNo, schoolId])
  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([gender, status])
}

model Subject {
  id                      Int                      @id @default(autoincrement())
  name                    String
  createdAt               DateTime                 @default(now())
  schoolId                String
  assignmentGradeSubjects AssignmentGradeSubject[]
  examGradeSubjects       ExamGradeSubject[]
  lessons                 Lesson[]
  results                 Result[]
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers                SubjectTeacher[]
  grades                  Grade[]                  @relation("SubjectGrades")

  @@unique([name, schoolId])
  @@index([schoolId])
}

model Teacher {
  id                      String                   @id @default(cuid())
  username                String
  name                    String
  parentName              String?
  email                   String?
  phone                   String
  address                 String
  img                     String?
  bloodType               String?
  gender                  Gender
  dob                     DateTime?
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  clerk_id                String?
  profileId               String?
  linkedUserId            String?                  @unique
  schoolId                String
  leftAt                  DateTime?
  leftReason              String?
  lessons                 Lesson[]
  subjects                SubjectTeacher[]
  linkedUser              LinkedUser?              @relation(fields: [linkedUserId], references: [id])
  profile                 Profile?                 @relation(fields: [profileId], references: [id])
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherClassAssignments TeacherClassAssignment[]

  @@unique([username, schoolId])
  @@unique([clerk_id, schoolId])
  @@index([schoolId])
  @@index([name])
  @@index([phone])
  @@index([clerk_id])
}

model TeacherClassAssignment {
  id             Int              @id @default(autoincrement())
  teacherId      String
  classId        Int
  schoolId       String
  role           ClassTeacherRole @default(SUBJECT)
  academicYearId Int
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         SchoolInfo       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, academicYearId, schoolId])
  @@index([classId, academicYearId])
  @@index([schoolId, classId])
  @@index([schoolId])
}

model SubjectTeacher {
  subjectId Int
  teacherId String
  classId   Int
  schoolId  String
  class     Class      @relation(fields: [classId], references: [id])
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id])
  teacher   Teacher    @relation(fields: [teacherId], references: [id])

  @@id([subjectId, teacherId, classId, schoolId])
  @@index([schoolId])
  @@index([teacherId, schoolId])
  @@index([classId, schoolId])
  @@index([subjectId, schoolId])
}

model FeeStructure {
  id             Int           @id @default(autoincrement())
  gradeId        Int
  startDate      DateTime
  dueDate        DateTime
  termFees       Int
  abacusFees     Int?
  term           Term
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  grade          Grade         @relation("GradeToFeesStructure", fields: [gradeId], references: [id])
  school         SchoolInfo    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFees    StudentFees[]

  @@unique([gradeId, term, academicYearId, schoolId])
  @@index([schoolId])
}

model FeeTransaction {
  id              Int          @id @default(autoincrement())
  studentId       String
  studentFeesId   Int
  term            Term
  amount          Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal      @default(0) @db.Decimal(12, 2)
  fineAmount      Decimal      @default(0) @db.Decimal(12, 2)
  receiptDate     DateTime
  receivedDate    DateTime?    @default(now())
  receiptNo       String
  paymentMode     PaymentMode  @default(CASH)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  remarks         String?
  transactionType String       @default("PAYMENT")
  updatedByName   String?
  deletedAt       DateTime?
  schoolId        String
  academicYearId  Int
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  school          SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFees     StudentFees  @relation("FeeTransactionStudentFees", fields: [studentFeesId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([receiptNo, schoolId])
  @@index([schoolId])
  @@index([studentFeesId])
  @@index([schoolId, receiptDate])
  @@index([academicYearId, receiptDate])
  @@index([studentId, academicYearId])
  @@index([studentId, term])
  @@index([schoolId, studentId, receiptDate])
}

model StudentFees {
  id               Int              @id @default(autoincrement())
  studentId        String
  feeStructureId   Int
  term             Term
  paidAmount       Int              @default(0)
  abacusPaidAmount Int?
  discountAmount   Int              @default(0)
  fineAmount       Int              @default(0)
  receiptDate      DateTime?
  receivedDate     DateTime?        @default(now())
  paymentMode      PaymentMode      @default(CASH)
  receiptNo        String?
  remarks          String?          @default("")
  updatedByName    String?
  schoolId         String
  academicYearId   Int
  feeTransactions  FeeTransaction[] @relation("FeeTransactionStudentFees")
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id])
  feeStructure     FeeStructure     @relation(fields: [feeStructureId], references: [id])
  school           SchoolInfo       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, term, schoolId], name: "studentId_academicYear_term")
  @@index([schoolId])
  @@index([studentId, academicYearId])
  @@index([studentId, term])
}

model StudentTotalFees {
  id                  Int          @id @default(autoincrement())
  studentId           String
  schoolId            String
  totalPaidAmount     Decimal      @default(0) @db.Decimal(12, 2)
  totalDiscountAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalFineAmount     Decimal      @default(0) @db.Decimal(12, 2)
  totalAbacusAmount   Decimal      @default(0) @db.Decimal(12, 2)
  totalFeeAmount      Decimal      @default(0) @db.Decimal(12, 2)
  dueAmount           Decimal      @default(0) @db.Decimal(12, 2)
  academicYearId      Int
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id])
  school              SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student             Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, academicYearId, schoolId])
  @@index([schoolId])
}

model Attendance {
  id             Int          @id @default(autoincrement())
  date           DateTime
  present        Boolean      @default(true)
  studentId      String
  classId        Int
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         SchoolInfo   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, academicYearId, schoolId])
  @@index([classId, date])
  @@index([studentId, classId])
  @@index([schoolId])
  @@index([schoolId, date])
  @@index([academicYearId, studentId])
  @@index([schoolId, classId, date])
}

model CancelledReceipt {
  id                String     @id @default(cuid())
  studentId         String
  term              Term
  originalReceiptNo String
  cancelledDate     DateTime   @default(now())
  cancelledBy       String?
  reason            String?
  cancelledAmount   Decimal    @default(0) @db.Decimal(12, 2)
  cancelledDiscount Decimal    @default(0) @db.Decimal(12, 2)
  cancelledFine     Decimal    @default(0) @db.Decimal(12, 2)
  cancelledTotal    Decimal    @default(0) @db.Decimal(12, 2)
  schoolId          String
  school            SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           Student    @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([term])
  @@index([originalReceiptNo])
  @@index([schoolId])
}

model PermissionSlip {
  id          Int        @id @default(autoincrement())
  studentId   String
  leaveType   LeaveType
  subReason   String?
  description String?
  date        DateTime   @default(now())
  timeIssued  DateTime   @default(now())
  withWhom    String?
  relation    String?
  schoolId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  school      SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id])

  @@index([schoolId])
}

model Profile {
  id           String       @id @default(cuid())
  clerk_id     String?      @unique
  phone        String?
  activeUserId String?
  admin        Admin[]
  users        LinkedUser[] @relation("ProfileUsers")
  activeUser   LinkedUser?  @relation("ActiveUser", fields: [activeUserId], references: [id])
  student      Student[]
  teacher      Teacher[]

  @@index([clerk_id])
  @@index([phone])
}

model LinkedUser {
  id        String     @id @default(cuid())
  username  String
  role      String
  profileId String
  schoolId  String
  admin     Admin?
  profile   Profile    @relation("ProfileUsers", fields: [profileId], references: [id])
  school    SchoolInfo @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activeFor Profile[]  @relation("ActiveUser")
  student   Student?
  teacher   Teacher?

  @@unique([username, schoolId])
  @@index([profileId, schoolId])
}

model FeePayment {
  id            Int           @id @default(autoincrement())
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  paymentDate   DateTime      @default(now())
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  orderId       String        @unique
  studentId     String
  schoolId      String
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  school        SchoolInfo    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
}

model StudentEnrollment {
  id             Int              @id @default(autoincrement())
  studentId      String
  classId        Int
  status         EnrollmentStatus @default(ACTIVE)
  promotedFromId Int?
  schoolId       String
  academicYearId Int
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         SchoolInfo       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, schoolId])
  @@index([academicYearId, classId])
  @@index([schoolId])
}

model ReceiptSequence {
  id             Int          @id @default(autoincrement())
  schoolId       String
  currentNo      Int          @default(0)
  updatedAt      DateTime     @updatedAt
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  school         SchoolInfo   @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, academicYearId])
}

model IdentityJob {
  id        String   @id @default(uuid())
  username  String
  phone     String
  name      String
  role      String
  schoolId  String
  status    String   @default("pending")
  attempts  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmsTemplate {
  id        Int         @id @default(autoincrement())
  type      MessageType
  content   String
  schoolId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  school    SchoolInfo  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([type, schoolId])
  @@index([schoolId])
}

model AcademicYear {
  name                    String
  startDate               DateTime
  endDate                 DateTime
  isActive                Boolean                  @default(false)
  schoolId                String
  id                      Int                      @id @default(autoincrement())
  school                  SchoolInfo               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendance              Attendance[]
  exams                   Exam[]
  examGradeSubject        ExamGradeSubject[]
  feeStructures           FeeStructure[]
  feeTransactions         FeeTransaction[]
  reciepts                ReceiptSequence[]
  results                 Result[]
  enrollments             StudentEnrollment[]
  studentFees             StudentFees[]
  studentTotalFees        StudentTotalFees[]
  teacherClassAssignments TeacherClassAssignment[]

  @@unique([name, schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId])
}

